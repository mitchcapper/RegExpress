<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
        <LangVersion>preview</LangVersion>
        <ApplicationIcon>RegExpress.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="RegExpress.ico" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="RegExpress.ico">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="PilotAIAssistantControlWPF" Version="1.0.4" />
      <PackageReference Include="WPFNativeThemeToggleControl" Version="1.0.22" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RegExpressLibrary\RegExpressLibrary.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="RegExpress.ico" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Properties\Settings.Designer.cs">
        <DesignTimeSharedInput>True</DesignTimeSharedInput>
        <AutoGen>True</AutoGen>
        <DependentUpon>Settings.settings</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Update="Engines.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Properties\Settings.settings">
        <Generator>SettingsSingleFileGenerator</Generator>
        <LastGenOutput>Settings.Designer.cs</LastGenOutput>
      </None>
    </ItemGroup>

</Project>
